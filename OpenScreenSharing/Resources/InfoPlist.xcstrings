    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحصل Screen Sharing على موقعك التقريبي فقط لمواصلة مشاركة شاشة هذا الجهاز أثناء استخدامك لتطبيقات أخرى أو عندما يكون الجهاز مقفلًا. ولا يحتفظ بموقعك ولا يرسله إلى أي مكان."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing получава приблизителното Ви местоположение само за да продължи да споделя екрана на това устройство, докато използвате други приложения или устройството е заключено. Приложението не съхранява местоположението Ви и не го изпраща никъде."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি অন্য অ্যাপ ব্যবহার করার সময় বা ডিভাইস লক থাকা অবস্থায় এই ডিভাইসের স্ক্রিন শেয়ার করা চালু রাখার জন্যই শুধু Screen Sharing-এ আপনার আনুমানিক লোকেশন নেওয়া হয়। আপনার লোকেশন সেভ করে রাখা বা কোথাও পাঠানো হয় না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app Screen Sharing obté la teva ubicació aproximada només per poder continuar compartint la pantalla d’aquest dispositiu mentre utilitzes altres apps o mentre el dispositiu està bloquejat. No desa la ubicació ni l’envia enlloc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Screen Sharing zjišťuje vaši přibližnou polohu pouze proto, aby mohla dál sdílet obrazovku tohoto zařízení, když používáte jiné aplikace nebo je zařízení zamknuté. Vaši polohu neukládá ani ji nikam neodesílá."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing henter kun din omtrentlige lokalitet for at kunne fortsætte med at dele skærmen på denne enhed, mens du bruger andre apps, eller mens enheden er låst. Lokaliteten bliver hverken gemt eller sendt nogen steder hen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing ruft deinen ungefähren Standort nur ab, um den Bildschirm dieses Geräts weiterhin freizugeben, während du andere Apps verwendest oder das Gerät gesperrt ist. Dein Standort wird weder aufbewahrt noch irgendwohin gesendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Screen Sharing λαμβάνει την κατά προσέγγιση τοποθεσία σας μόνο για να συνεχίζει την κοινή χρήση της οθόνης αυτής της συσκευής ενώ χρησιμοποιείτε άλλες εφαρμογές ή όταν η συσκευή είναι κλειδωμένη. Δεν διατηρεί την τοποθεσία σας ούτε τη στέλνει πουθενά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Screen Sharing gets your approximate location only to keep sharing this device’s screen while you use other apps or the device is locked. It doesn’t keep your location or send it anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing obtiene tu ubicación aproximada solo para seguir compartiendo la pantalla de este dispositivo mientras usas otras apps o el dispositivo está bloqueado. No guarda tu ubicación ni la envía a ningún sitio."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing obtiene tu ubicación aproximada sólo para seguir compartiendo la pantalla de este dispositivo mientras usas otras apps o cuando el dispositivo está bloqueado. No guarda tu ubicación ni la envía a ningún lugar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing hakee likimääräisen sijaintisi vain, jotta tämän laitteen näytön jakaminen voi jatkua, kun käytät muita appeja tai laite on lukittuna. Se ei tallenna sijaintiasi eikä lähetä sitä minnekään."
