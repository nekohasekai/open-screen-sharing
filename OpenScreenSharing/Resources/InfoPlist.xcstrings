    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبحث Screen Sharing عن أجهزة Mac على الشبكة المحلية ويتصل بها."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing намира компютри Mac в локалната Ви мрежа и се свързва с тях."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing-এর মাধ্যমে আপনি আপনার লোকাল নেটওয়ার্কে থাকা Mac খুঁজে সেগুলিতে কানেক্ট করতে পারবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app Screen Sharing cerca Macs a la xarxa local i s’hi connecta."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Screen Sharing vyhledává Macy ve vaší místní síti a připojuje se k nim."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing finder og opretter forbindelse til Mac-computere på dit lokale netværk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing sucht Mac-Computer in deinem lokalen Netzwerk und stellt eine Verbindung zu ihnen her."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Screen Sharing εντοπίζει και συνδέεται σε υπολογιστές Mac στο τοπικό σας δίκτυο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Screen Sharing finds and connects to Macs on your local network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing busca los Mac de la red local y se conecta a ellos."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing busca computadoras Mac en tu red local y se conecta a ellas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing etsii lähiverkossasi olevia Maceja ja yhdistää niihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing recherche les Mac de votre réseau local et s’y connecte."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app Screen Sharing recherche les Mac de votre réseau local et s’y connecte."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing તમારા લોકલ નેટવર્ક પરના Mac શોધે છે અને તેમની સાથે કનેક્ટ કરે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‏Screen Sharing מאתר מחשבי Mac ברשת המקומית ומתחבר אליהם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing आपके स्थानीय नेटवर्क पर Mac ढूँढता है और उनसे कनेक्ट होता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing pronalazi Mac računala na vašoj lokalnoj mreži i spaja se na njih."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Screen Sharing megkeresi a helyi hálózaton lévő Mac gépeket, és kapcsolódik hozzájuk."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing mencari dan terhubung ke Mac di jaringan lokal Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing cerca i Mac sulla rete locale e si connette a essi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharingは、ローカルネットワーク上のMacを検出して接続します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing жергілікті желідегі Mac компьютерлерін тауып, оларға қосылады."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing ಆ್ಯಪ್ ನಿಮ್ಮ ಸ್ಥಳೀಯ ನೆಟ್‌ವರ್ಕ್‌ನಲ್ಲಿರುವ Macಗಳನ್ನು ಹುಡುಕುತ್ತದೆ ಮತ್ತು ಅವುಗಳಿಗೆ ಕನೆಕ್ಟ್ ಆಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing은 로컬 네트워크에 있는 Mac을 찾아 연결합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Screen Sharing” randa „Mac” kompiuterius jūsų vietiniame tinkle ir prie jų prisijungia."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing നിങ്ങളുടെ ലോക്കൽ നെറ്റ്‌വർക്കിലെ Mac-കൾ കണ്ടെത്തി അവയിലേക്ക് കണക്റ്റ് ചെയ്യുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing तुमच्या स्थानिक नेटवर्कवरील Mac शोधते आणि त्यांच्याशी कनेक्ट करते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing mencari dan menyambung ke Mac pada rangkaian setempat anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing finner og kobler til Mac-maskiner på det lokale nettverket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing zoekt naar Macs in je lokale netwerk en maakt er verbinding mee."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing ଆପଣଙ୍କ ସ୍ଥାନୀୟ ନେଟ୍‌ୱର୍କ୍‌ରେ ଥିବା Mac ଖୋଜେ ଏବଂ ସେଗୁଡ଼ିକ ସହ ସଂଯୋଗ କରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing ਤੁਹਾਡੇ ਸਥਾਨਕ ਨੈੱਟਵਰਕ 'ਤੇ Mac ਲੱਭਦੀ ਹੈ ਅਤੇ ਉਹਨਾਂ ਨਾਲ ਕਨੈਕਟ ਕਰਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja Screen Sharing wyszukuje komputery Mac w Twojej sieci lokalnej i łączy się z nimi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
