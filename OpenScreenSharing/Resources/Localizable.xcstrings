    "Raising the resolution by scaling reduces sharpness and increases bandwidth use and picture latency." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تؤدي زيادة الدقة عبر تغيير المقياس إلى تقليل الوضوح وزيادة استخدام النطاق الترددي وتأخر الصورة."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увеличаването на разделителната способност чрез мащабиране намалява рязкостта и увеличава използваната честотна лента и забавянето на картината."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্কেলিং করে রেজোলিউশন বাড়ালে স্পষ্টতা কমে যায় এবং ব্যান্ডউইথের ব্যবহার ও ছবির ল্যাটেন্সি বেড়ে যায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Augmentar la resolució mitjançant l’escalat redueix la nitidesa i augmenta l’ús d’amplada de banda i la latència de la imatge."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvýšení rozlišení pomocí změny měřítka snižuje ostrost a zvyšuje využití přenosového pásma a zpoždění obrazu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skalering til en højere opløsning gør billedet mindre skarpt og øger båndbreddeforbruget og billedforsinkelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine durch Skalierung erhöhte Auflösung verringert die Schärfe und erhöht Bandbreitenbedarf und Bildlatenz."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η αύξηση της ανάλυσης μέσω κλιμάκωσης μειώνει την ευκρίνεια και αυξάνει τη χρήση εύρους ζώνης και την καθυστέρηση της εικόνας."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentar la resolución mediante el escalado reduce la nitidez y aumenta el uso de ancho de banda y la latencia de la imagen."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentar la resolución mediante el escalado reduce la nitidez y aumenta el uso de ancho de banda y la latencia de la imagen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkkuuden nostaminen skaalaamalla heikentää terävyyttä sekä lisää kaistanleveyden käyttöä ja kuvan viivettä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Augmenter la résolution par mise à l’échelle réduit la netteté et augmente l’utilisation de la bande passante et la latence de l’image."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Augmenter la résolution par mise à l’échelle réduit la netteté et augmente l’utilisation de la bande passante et la latence de l’image."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "સ્કેલિંગ દ્વારા રિઝોલ્યૂશન વધારવાથી શાર્પનેસ ઘટે છે અને બૅન્ડવિડ્થનો વપરાશ અને ચિત્રમાં વિલંબ વધે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדלת הרזולוציה באמצעות שינוי קנה מידה פוגעת בחדות ומגדילה את צריכת רוחב הפס ואת השהיית התמונה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्केलिंग से रिज़ोल्यूशन बढ़ाने पर शार्पनेस कम होती है, और बैंडविड्थ का उपयोग और तस्वीर आने में देरी बढ़ जाती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povećanje razlučivosti skaliranjem smanjuje oštrinu i povećava potrošnju propusnosti te kašnjenje slike."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha méretezéssel növeli a felbontást, csökken az élesség, és nő a sávszélesség-használat és a kép késleltetése."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menaikkan resolusi dengan penskalaan akan mengurangi ketajaman serta meningkatkan penggunaan bandwidth dan latensi gambar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentare la risoluzione con il ridimensionamento riduce la nitidezza e aumenta l’uso di banda e la latenza dell’immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "倍率を上げて解像度を高くすると、鮮明さが低下し、帯域幅の使用量と画面の遅延が増加します。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Масштабтау арқылы ажыратымдылықты арттыру анықтықты төмендетіп, трафик пен кескін кідірісін арттырады."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸ್ಕೇಲಿಂಗ್ ಮೂಲಕ ರೆಸಲ್ಯೂಶನ್ ಹೆಚ್ಚಿಸುವುದರಿಂದ ಸ್ಪಷ್ಟತೆ ಕಡಿಮೆಯಾಗುತ್ತದೆ ಮತ್ತು ಬ್ಯಾಂಡ್‌ವಿಡ್ತ್ ಬಳಕೆ ಹಾಗೂ ಚಿತ್ರದ ವಿಳಂಬ ಹೆಚ್ಚಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크기 조절로 해상도를 높이면 선명도가 낮아지고 대역폭 사용량과 화면 지연 시간이 늘어납니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Didinant skyrą mastelio keitimu, mažėja vaizdo aštrumas, o pralaidumo naudojimas ir vaizdo delsa didėja."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "സ്കെയിലിങ് വഴി റെസല്യൂഷൻ കൂട്ടുന്നത് വ്യക്തത കുറയ്ക്കുകയും ബാൻഡ്‌വിഡ്ത്ത് ഉപയോഗവും ചിത്രത്തിന്റെ ലേറ്റൻസിയും കൂട്ടുകയും ചെയ്യും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्केलिंग करून रिझोल्यूशन वाढवल्यास स्पष्टता कमी होते आणि बँडविड्थचा वापर व चित्राचा विलंब वाढतो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menaikkan resolusi melalui penskalaan akan mengurangkan ketajaman serta meningkatkan penggunaan lebar jalur dan kependaman gambar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du øker oppløsningen med skalering, blir bildet mindre skarpt, og både båndbreddebruk og bildeforsinkelse øker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een hogere resolutie via schalen vermindert de scherpte en verhoogt het bandbreedtegebruik en de beeldvertraging."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସ୍କେଲିଂ ଦ୍ବାରା ରିଜୋଲ୍ୟୁଶନ୍ ବଢ଼ାଇଲେ ସ୍ପଷ୍ଟତା କମିଯାଏ ଏବଂ ବ୍ୟାଣ୍ଡୱିଡ୍ଥ୍ ବ୍ୟବହାର ଓ ଛବିର ବିଳମ୍ବ ବଢ଼ିଯାଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਸਕੇਲਿੰਗ ਰਾਹੀਂ ਰੈਜ਼ੋਲਿਊਸ਼ਨ ਵਧਾਉਣ ਨਾਲ ਤਿੱਖਾਪਣ ਘਟਦਾ ਹੈ ਅਤੇ ਬੈਂਡਵਿਡਥ ਦੀ ਵਰਤੋਂ ਅਤੇ ਤਸਵੀਰ ਦੀ ਦੇਰੀ ਵਧਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwiększanie rozdzielczości przez skalowanie zmniejsza ostrość oraz zwiększa zużycie przepustowości i opóźnienie obrazu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentar a resolução por redimensionamento reduz a nitidez e aumenta o uso de banda e a latência da imagem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentar a resolução através da escala reduz a nitidez e aumenta a utilização da largura de banda e a latência da imagem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mărirea rezoluției prin redimensionare reduce claritatea și crește consumul de lățime de bandă și latența imaginii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повышение разрешения за счет масштабирования снижает четкость, увеличивает нагрузку на сеть и задержку изображения."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zvýšenie rozlíšenia škálovaním znižuje ostrosť a zvyšuje využitie prenosového pásma aj oneskorenie obrazu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povečanje ločljivosti s prilagajanjem velikosti zmanjša ostrino ter poveča porabo pasovne širine in zakasnitev slike."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du höjer upplösningen genom skalning blir bilden mindre skarp, och både bandbreddsanvändningen och bildfördröjningen ökar."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அளவிடுதல் மூலம் தெளிவுத்திறனை அதிகரிப்பது கூர்மையைக் குறைக்கும். பேண்ட்வித் பயன்பாட்டையும் படத் தாமதத்தையும் அதிகரிக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "స్కేలింగ్ ద్వారా రిజల్యూషన్‌ను పెంచితే షార్ప్‌నెస్ తగ్గుతుంది, అలాగే బ్యాండ్‌విడ్త్ వినియోగం, చిత్రం ఆలస్యం పెరుగుతాయి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเพิ่มความละเอียดด้วยการปรับมาตราส่วนจะลดความคมชัด และเพิ่มการใช้แบนด์วิดท์และความหน่วงของภาพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çözünürlüğü ölçekleyerek artırmak netliği azaltır, bant genişliği kullanımını ve görüntü gecikmesini artırır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підвищення роздільності за допомогою масштабування знижує чіткість і збільшує використання пропускної здатності та затримку зображення."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسکیلنگ کے ذریعے ریزولوشن بڑھانے سے وضاحت کم ہو جاتی ہے، جبکہ بینڈوڈتھ کا استعمال اور تصویر کی تاخیر بڑھ جاتی ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tăng độ phân giải bằng cách định tỷ lệ sẽ làm giảm độ sắc nét, đồng thời tăng mức sử dụng băng thông và độ trễ hình ảnh."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過縮放提高解像度會降低清晰度，並增加頻寬用量與畫面延遲。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过裁切实现的分辨率增加将降低清晰度、增加带宽使用和画面延迟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過縮放提高解析度會降低清晰度，並增加頻寬用量與畫面延遲。"
          }
        }
      }
    },
