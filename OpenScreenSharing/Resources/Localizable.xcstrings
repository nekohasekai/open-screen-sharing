    "When Magic Keyboard is connected, you can also use %@ Dictation and the %@ emoji keyboard on this iPad." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند توصيل Magic Keyboard، يمكنك أيضًا استخدام الإملاء %1$@ ولوحة مفاتيح الرموز التعبيرية %2$@ على هذا الـ iPad."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когато Magic Keyboard е свързана, можете да използвате и диктовката %1$@ и клавиатурата с емоджи %2$@ на този iPad."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Keyboard সংযুক্ত থাকলে, এই iPad-এর %1$@ ডিক্টেশন এবং %2$@ ইমোজি কীবোর্ডও ব্যবহার করতে পারবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan el Magic Keyboard està connectat, també pots utilitzar el dictat %1$@ i el teclat d’emojis %2$@ d’aquest iPad."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když je připojená klávesnice Magic Keyboard, můžete na tomto iPadu používat také diktování %1$@ a klávesnici emodži %2$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når Magic Keyboard er tilsluttet, kan du også bruge diktering %1$@ og emojitastaturet %2$@ på denne iPad."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn das Magic Keyboard verbunden ist, kannst du auf diesem iPad auch das Diktat %1$@ und die Emoji-Tastatur %2$@ verwenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν είναι συνδεδεμένο το Magic Keyboard, μπορείτε επίσης να χρησιμοποιήσετε την υπαγόρευση %1$@ και το πληκτρολόγιο emoji %2$@ αυτού του iPad."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el Magic Keyboard está conectado, también puedes usar el dictado %1$@ y el teclado de emojis %2$@ de este iPad."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando el Magic Keyboard está conectado, también puedes usar el dictado %1$@ y el teclado de emojis %2$@ de este iPad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun Magic Keyboard on yhdistetty, voit käyttää myös tämän iPadin sanelua %1$@ ja emojinäppäimistöä %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque le Magic Keyboard est connecté, vous pouvez aussi utiliser la dictée %1$@ et le clavier Emoji %2$@ de cet iPad."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque le Magic Keyboard est connecté, vous pouvez aussi utiliser la dictée %1$@ et le clavier Emoji %2$@ de cet iPad."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Keyboard કનેક્ટ હોય ત્યારે, તમે આ iPad નું %1$@ ડિક્ટેશન અને %2$@ ઇમોજી કીબોર્ડ પણ વાપરી શકો છો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כאשר Magic Keyboard מחובר, אפשר להשתמש גם בהכתבה %1$@ ובמקלדת האמוג׳י %2$@ של ה‑iPad הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Keyboard कनेक्ट होने पर, आप इस iPad का %1$@ डिक्टेशन और %2$@ इमोजी कीबोर्ड भी इस्तेमाल कर सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada je Magic Keyboard povezan, na ovom iPadu možete koristiti i diktiranje %1$@ te tipkovnicu s emotikonima %2$@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha a Magic Keyboard csatlakoztatva van, ezen az iPaden a diktálást %1$@ és az emojibillentyűzetet %2$@ is használhatja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat Magic Keyboard tersambung, Anda juga dapat menggunakan dikte %1$@ dan papan ketik emoji %2$@ di iPad ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando Magic Keyboard è collegata, puoi usare anche la dettatura %1$@ e la tastiera emoji %2$@ di questo iPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Keyboardを接続しているときは、このiPadの%1$@音声入力と%2$@絵文字キーボードも使用できます。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Keyboard қосылған кезде, осы iPad құрылғысындағы %1$@ диктовканы және %2$@ эмодзи пернетақтасын да пайдалана аласыз."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Keyboard ಕನೆಕ್ಟ್ ಆಗಿರುವಾಗ, ಈ iPad ನ %1$@ ಡಿಕ್ಟೇಶನ್ ಮತ್ತು %2$@ ಎಮೋಜಿ ಕೀಬೋರ್ಡ್ ಅನ್ನು ಸಹ ಬಳಸಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Keyboard가 연결되어 있으면 이 iPad의 %1$@ 받아쓰기와 %2$@ 이모티콘 키보드도 사용할 수 있습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kai prijungta Magic Keyboard, šiame iPad taip pat galite naudoti diktavimą %1$@ ir jaustukų klaviatūrą %2$@."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Keyboard കണക്റ്റ് ചെയ്തിരിക്കുമ്പോൾ, ഈ iPad-ലെ %1$@ ഡിക്റ്റേഷനും %2$@ ഇമോജി കീബോർഡും ഉപയോഗിക്കാം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Keyboard कनेक्ट असताना, तुम्ही या iPad चे %1$@ डिक्टेशन आणि %2$@ इमोजी कीबोर्ड देखील वापरू शकता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila Magic Keyboard disambungkan, anda juga boleh menggunakan diktasi %1$@ dan papan kekunci emoji %2$@ pada iPad ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når Magic Keyboard er tilkoblet, kan du også bruke diktering %1$@ og emojitastaturet %2$@ på denne iPaden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als het Magic Keyboard is verbonden, kun je op deze iPad ook dicteren %1$@ en het emojitoetsenbord %2$@ gebruiken."
