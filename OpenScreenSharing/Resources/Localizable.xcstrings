    "Screen Sharing couldn’t keep waiting for Settings in the background." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على Screen Sharing مواصلة انتظار الإعدادات في الخلفية."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing не можа да продължи да чака Настройки във фонов режим."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing-এ ব্যাকগ্রাউন্ডে সেটিংসের জন্য অপেক্ষা চালিয়ে যাওয়া যায়নি।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
