    "Before sharing this device’s screen, pair and import the disk image." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل مشاركة شاشة هذا الجهاز، يجب إقرانه واستيراد صورة القرص."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преди да споделите екрана на това устройство, извършете сдвояване и импортирайте дисковия образ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ডিভাইসের স্ক্রিন শেয়ার করার আগে পেয়ার করুন এবং ডিস্ক ইমেজ ইমপোর্ট করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abans de compartir la pantalla d’aquest dispositiu, enllaça’l i importa la imatge de disc."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Než začnete sdílet obrazovku tohoto zařízení, proveďte spárování a importujte obraz disku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du skal danne par og importere diskbilledet, før du kan dele skærmen på denne enhed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopple dieses Gerät und importiere das Festplattenimage, bevor du seinen Bildschirm freigibst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πριν από την κοινή χρήση της οθόνης αυτής της συσκευής, κάντε ζευγοποίηση και εισαγάγετε το είδωλο δίσκου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de compartir la pantalla de este dispositivo, enlázalo e importa la imagen de disco."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de compartir la pantalla de este dispositivo, enlázalo e importa la imagen de disco."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennen kuin jaat tämän laitteen näytön, tee pari ja tuo levykuva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de partager l’écran de cet appareil, jumelez-le et importez l’image disque."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant de partager l’écran de cet appareil, jumelez-le et importez l’image disque."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ ડિવાઇસની સ્ક્રીન શેર કરતાં પહેલાં, પેર કરો અને ડિસ્ક ઇમેજ ઇંપોર્ટ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לפני שיתוף המסך של המכשיר הזה, יש לבצע קישור ולייבא את תמונת הדיסק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस की स्क्रीन शेयर करने से पहले, पेयर करें और डिस्क इमेज इंपोर्ट करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prije dijeljenja zaslona ovog uređaja uparite ga i importirajte sliku diska."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az eszköz képernyőjének megosztása előtt végezze el a párosítást, és importálja a lemezképet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum membagikan layar perangkat ini, pasangkan dan impor image disk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di condividere lo schermo di questo dispositivo, esegui l’abbinamento e importa l’immagine disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスの画面を共有する前に、ペアリングしてディスクイメージを読み込んでください。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осы құрылғының экранын бөлісу алдында жұптап, диск бейнесін импорттаңыз."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಸಾಧನದ ಸ್ಕ್ರೀನ್ ಹಂಚಿಕೊಳ್ಳುವ ಮೊದಲು, ಪೇರ್ ಮಾಡಿ ಮತ್ತು ಡಿಸ್ಕ್ ಇಮೇಜ್ ಅನ್ನು ಇಂಪೋರ್ಟ್ ಮಾಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 화면을 공유하기 전에 페어링하고 디스크 이미지를 가져오십시오."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prieš bendrinant šio įrenginio ekraną, reikia susieti ir importuoti disko vaizdą."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ ഡിവൈസിന്റെ സ്ക്രീൻ പങ്കിടുന്നതിന് മുമ്പ്, പെയർ ചെയ്ത് ഡിസ്ക് ഇമേജ് ഇംപോർട്ട് ചെയ്യൂ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या डिव्हाइसची स्क्रीन शेअर करण्यापूर्वी, पेअर करा आणि डिस्क इमेज इंपोर्ट करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum berkongsi skrin peranti ini, pasangkan dan import imej cakera."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koble sammen og importer diskbildet før du deler skjermen på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppel dit apparaat en importeer de schijfkopie voordat je het scherm van dit apparaat deelt."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହି ଡିଭାଇସ୍‌ର ସ୍କ୍ରିନ୍ ଶେୟାର୍ କରିବା ପୂର୍ବରୁ, ପେୟାର୍ କରନ୍ତୁ ଏବଂ ଡିସ୍କ୍ ଇମେଜ୍ ଇମ୍ପୋର୍ଟ୍ କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਡਿਵਾਈਸ ਦੀ ਸਕਰੀਨ ਸਾਂਝੀ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ, ਜੋੜਾਬੱਧ ਕਰੋ ਅਤੇ ਡਿਸਕ ਇਮੇਜ ਇੰਪੋਰਟ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed udostępnieniem ekranu tego urządzenia sparuj je i zaimportuj obraz dysku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de compartilhar a tela deste dispositivo, emparelhe-o e importe a imagem de disco."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de partilhar o ecrã deste dispositivo, emparelhe‑o e importe a imagem de disco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înainte de a partaja ecranul acestui dispozitiv, asociați-l și importați imaginea de disc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перед открытием общего доступа к экрану этого устройства создайте пару и импортируйте образ диска."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pred zdieľaním obrazovky tohto zariadenia vykonajte párovanie a importujte obraz disku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pred deljenjem zaslona te naprave opravite seznanjanje in uvozite sliko diska."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parkoppla och importera skivavbilden innan du delar skärmen på den här enheten."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தச் சாதனத்தின் திரையைப் பகிர்வதற்கு முன் இணைசேர்த்து டிஸ்க் இமேஜை இம்போர்ட் செய்யவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ డివైజ్ స్క్రీన్‌ను షేర్ చేసే ముందు, పెయిర్ చేసి, డిస్క్ ఇమేజ్‌ను ఇంపోర్ట్ చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จับคู่และนำเข้าภาพดิสก์ก่อนแชร์หน้าจอของอุปกรณ์นี้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aygıtın ekranını paylaşmadan önce eşleme yapın ve disk görüntüsünü içe aktarın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перш ніж поширювати екран цього пристрою, створіть пару та імпортуйте образ диска."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس ڈیوائس کی اسکرین شیئر کرنے سے پہلے پیئر کریں اور ڈسک امیج امپورٹ کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trước khi chia sẻ màn hình của thiết bị này, hãy ghép đôi và nhập ảnh đĩa."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享此裝置的螢幕前，請先配對並輸入磁碟映像檔。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享此设备的屏幕前，需要先配对并导入磁盘映像。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
