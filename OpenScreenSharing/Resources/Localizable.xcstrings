        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเชื่อมต่อ Magic Keyboard คุณยังสามารถใช้การป้อนตามคำบอก %1$@ และแป้นพิมพ์อีโมจิ %2$@ ของ iPad เครื่องนี้ได้ด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Keyboard bağlıyken bu iPad’in dikte özelliğini %1$@ ve emoji klavyesini %2$@ de kullanabilirsiniz."
