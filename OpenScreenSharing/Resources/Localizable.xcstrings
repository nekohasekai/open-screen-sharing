        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Keyboard ਕਨੈਕਟ ਹੋਣ 'ਤੇ, ਤੁਸੀਂ ਇਸ iPad ਦਾ %1$@ ਡਿਕਟੇਸ਼ਨ ਅਤੇ %2$@ ਇਮੋਜੀ ਕੀਬੋਰਡ ਵੀ ਵਰਤ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy klawiatura Magic Keyboard jest połączona, możesz też używać dyktowania %1$@ i klawiatury emoji %2$@ na tym iPadzie."
