        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Keyboard کنیکٹ ہونے پر، آپ اس iPad کی %1$@ ڈکٹیشن اور %2$@ ایموجی کی بورڈ بھی استعمال کر سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi Magic Keyboard được kết nối, bạn cũng có thể sử dụng tính năng đọc chính tả %1$@ và bàn phím biểu tượng cảm xúc %2$@ trên iPad này."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連接妙控鍵盤時，本機 %1$@ 語音輸入和 %2$@ Emoji 輸入面板也可以使用。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接妙控键盘时，本机 %1$@ 语音输入和 %2$@ Emoji 输入面板也可以使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連接巧控鍵盤時，本機 %1$@ 語音輸入和 %2$@ Emoji 輸入面板也可以使用。"
          }
        }
      }
    },
    "When using a mouse or trackpad, turn on %@ › %@ so moving to the edge of the screen won’t open the Dock or Control Center." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند استخدام الماوس أو لوحة التعقب، شغّل %1$@ > %2$@ حتى لا يؤدي الانتقال إلى حافة الشاشة إلى فتح شريط Dock أو مركز التحكم."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когато използвате мишка или тракпад, включете %1$@ › %2$@, за да не се отварят лентата Dock или Контролният център, когато стигнете до ръба на екрана."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মাউস বা ট্র্যাকপ্যাড ব্যবহার করার সময় %1$@ › %2$@ চালু করুন, যাতে স্ক্রিনের প্রান্তে গেলে ডক বা কন্ট্রোল সেন্টার না খোলে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quan facis servir un ratolí o un trackpad, activa %1$@ › %2$@ perquè, en arribar a la vora de la pantalla, no s’obri el Dock ni el centre de control."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když používáte myš nebo trackpad, zapněte %1$@ › %2$@ – po najetí k okraji obrazovky se pak neotevře Dock ani Ovládací centrum."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du bruger en mus eller et pegefelt, skal du slå %1$@ › %2$@ til, så Dock eller Kontrolcenter ikke åbnes, når du bevæger dig ud til skærmens kant."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du eine Maus oder ein Trackpad verwendest, aktiviere „%1$@“ > „%2$@“, damit sich am Bildschirmrand nicht das Dock oder das Kontrollzentrum öffnet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Όταν χρησιμοποιείτε ποντίκι ή trackpad, ενεργοποιήστε το %1$@ › %2$@, ώστε η μετακίνηση στην άκρη της οθόνης να μην ανοίγει το Dock ή το Κέντρο ελέγχου."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando uses un ratón o un trackpad, activa %1$@ > %2$@ para que, al llegar al borde de la pantalla, no se abra el Dock ni el centro de control."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando uses un mouse o un trackpad, activa %1$@ > %2$@ para que, al llegar al borde de la pantalla, no se abra el Dock ni el centro de control."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun käytät hiirtä tai ohjauslevyä, laita %1$@ › %2$@ päälle, jotta näytön reunaan siirtyminen ei avaa Dockia tai Ohjauskeskusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous utilisez une souris ou un trackpad, activez %1$@ > %2$@ pour que le Dock ou le centre de contrôle ne s’ouvre pas lorsque vous atteignez le bord de l’écran."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous utilisez une souris ou un trackpad, activez %1$@ > %2$@ pour que le Dock ou le centre de contrôle ne s’ouvre pas lorsque vous atteignez le bord de l’écran."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "માઉસ અથવા ટ્રેકપેડનો ઉપયોગ કરતી વખતે %1$@ › %2$@ ચાલુ કરો, જેથી સ્ક્રીનની કિનારી પર જવાથી ડૉક અથવા કંટ્રોલ સેન્ટર ખૂલે નહીં."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בעת שימוש בעכבר או במשטח מגע, יש להפעיל את ״%1$@״ › ״%2$@״ כדי שתנועה לקצה המסך לא תפתח את ה‑Dock או את מרכז הבקרה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माउस या ट्रैकपैड का उपयोग करते समय %1$@ › %2$@ चालू करें, ताकि स्क्रीन के किनारे पर जाने से डॉक या कंट्रोल सेंटर न खुले।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kada upotrebljavate miš ili trackpad, uključite %1$@ › %2$@ kako se pomicanjem do ruba zaslona ne bi otvarali Dock ili Kontrolni centar."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egér vagy trackpad használatakor kapcsolja be a(z) %1$@ › %2$@ lehetőséget, így a képernyő széléhez érve nem nyílik meg a Dock vagy a Vezérlőközpont."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat menggunakan mouse atau trackpad, nyalakan %1$@ › %2$@ agar bergerak ke tepi layar tidak membuka Dock atau Pusat Kontrol."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando usi un mouse o un trackpad, attiva %1$@ › %2$@: così, raggiungendo il bordo dello schermo, non si apriranno il Dock o Centro di Controllo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マウスまたはトラックパッドを使用しているときは、“%1$@”＞“%2$@”をオンにすると、画面の端に移動してもDockやコントロールセンターが開かなくなります。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тінтуір немесе трекпад пайдаланғанда %1$@ › %2$@ параметрін қосыңыз, сонда экран шетіне жеткенде Dock немесе Басқару орталығы ашылмайды."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮೌಸ್ ಅಥವಾ ಟ್ರ್ಯಾಕ್‌ಪ್ಯಾಡ್ ಬಳಸುವಾಗ %1$@ › %2$@ ಆನ್ ಮಾಡಿ, ಆಗ ಸ್ಕ್ರೀನ್‌ನ ಅಂಚಿಗೆ ಹೋದಾಗ ಡಾಕ್ ಅಥವಾ ಕಂಟ್ರೋಲ್ ಸೆಂಟರ್ ತೆರೆಯುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마우스나 트랙패드를 사용할 때 ‘%1$@’ > ‘%2$@’을(를) 켜면 화면 가장자리로 이동해도 Dock이나 제어 센터가 열리지 않습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naudodami pelę arba jutiklinį kilimėlį, įjunkite „%1$@” › „%2$@”, kad pasiekus ekrano kraštą neatsidarytų „Dock” arba Valdymo centras."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "മൗസോ ട്രാക്ക്‌പാഡോ ഉപയോഗിക്കുമ്പോൾ %1$@ › %2$@ ഓണാക്കുക, അപ്പോൾ സ്ക്രീനിന്റെ അരികിലേക്ക് നീങ്ങുമ്പോൾ ഡോക്കോ കൺട്രോൾ സെന്ററോ തുറക്കില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माउस किंवा ट्रॅकपॅड वापरताना %1$@ › %2$@ चालू करा, म्हणजे स्क्रीनच्या कडेला गेल्यावर डॉक किंवा कंट्रोल सेंटर उघडणार नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apabila menggunakan tetikus atau pad jejak, aktifkan %1$@ › %2$@ supaya bergerak ke tepi skrin tidak membuka Dock atau Pusat Kawalan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når du bruker mus eller styreflate, slår du på %1$@ › %2$@, slik at Dock eller Kontrollsenter ikke åpnes når du beveger deg til kanten av skjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je een muis of trackpad gebruikt, schakel je %1$@ › %2$@ in, zodat het Dock of het bedieningspaneel niet opent wanneer je naar de rand van het scherm gaat."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ମାଉସ୍ କିମ୍ବା ଟ୍ରାକ୍‌ପ୍ୟାଡ୍ ବ୍ୟବହାର କରିବା ସମୟରେ %1$@ › %2$@ ଅନ୍ କରନ୍ତୁ, ଯାହାଦ୍ୱାରା ସ୍କ୍ରିନ୍‌ର ଧାରକୁ ଗଲେ ଡକ୍ କିମ୍ବା କଣ୍ଟ୍ରୋଲ୍ ସେଣ୍ଟର୍ ଖୋଲିବ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਮਾਊਸ ਜਾਂ ਟ੍ਰੈਕਪੈਡ ਵਰਤਦੇ ਸਮੇਂ %1$@ › %2$@ ਚਾਲੂ ਕਰੋ, ਤਾਂ ਜੋ ਸਕ੍ਰੀਨ ਦੇ ਕਿਨਾਰੇ ’ਤੇ ਜਾਣ ਨਾਲ ਡੌਕ ਜਾਂ ਕੰਟਰੋਲ ਸੈਂਟਰ ਨਾ ਖੁੱਲ੍ਹੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy używasz myszy lub gładzika, włącz %1$@ › %2$@, aby przesunięcie do krawędzi ekranu nie otwierało Docka ani centrum sterowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao usar um mouse ou trackpad, ative %1$@ › %2$@ para que mover até a borda da tela não abra o Dock ou a Central de Controle."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao usar um rato ou um trackpad, ative %1$@ › %2$@ para que, ao chegar à margem do ecrã, não se abra a Dock nem a central de controlo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Când folosiți un mouse sau un trackpad, activați %1$@ › %2$@, astfel încât deplasarea spre marginea ecranului să nu deschidă Dock-ul sau Centrul de control."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При использовании мыши или трекпада включите «%1$@» > «%2$@», чтобы при перемещении к краю экрана не открывались Dock или Пункт управления."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keď používate myš alebo trackpad, zapnite %1$@ › %2$@ – po presune k okraju obrazovky sa potom neotvorí Dock ani Ovládacie centrum."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko uporabljate miško ali sledilno ploščico, vklopite %1$@ › %2$@, da se ob premiku do roba zaslona ne odpre Dock ali Nadzorno središče."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du använder en mus eller styrplatta slår du på %1$@ › %2$@ så att Dock eller Kontrollcenter inte öppnas när du rör dig till skärmens kant."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மவுஸ் அல்லது டிராக்பேடைப் பயன்படுத்தும்போது %1$@ › %2$@ என்பதை இயக்கவும், அப்போது திரையின் விளிம்புக்குச் சென்றாலும் டாக் அல்லது கட்டுப்பாட்டு மையம் திறக்காது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మౌస్ లేదా ట్రాక్‌ప్యాడ్ ఉపయోగిస్తున్నప్పుడు ‘%1$@’ › ‘%2$@’ ఆన్ చేయండి, అప్పుడు స్క్రీన్ అంచుకు వెళ్లినా డాక్ లేదా కంట్రోల్ సెంటర్ తెరుచుకోదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อใช้เมาส์หรือแทร็คแพด ให้เปิด %1$@ › %2$@ เพื่อไม่ให้ Dock หรือศูนย์ควบคุมเปิดขึ้นเมื่อเลื่อนไปที่ขอบหน้าจอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fare veya izleme dörtgeni kullanırken %1$@ › %2$@ seçeneğini açın; böylece ekranın kenarına gittiğinizde Dock veya Denetim Merkezi açılmaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли використовуєте мишу або трекпад, увімкніть %1$@ › %2$@, щоб під час переміщення до краю екрана не відкривалися Dock або Пункт керування."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماؤس یا ٹریک پیڈ استعمال کرتے وقت %1$@ › %2$@ آن کریں، تاکہ اسکرین کے کنارے پر جانے سے ڈاک یا کنٹرول سینٹر نہ کھلے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi dùng chuột hoặc bàn di chuột, hãy bật %1$@ > %2$@ để việc di chuyển tới cạnh màn hình không mở Dock hoặc Trung tâm điều khiển."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用滑鼠或觸控式軌跡板時，開啟「%1$@」>「%2$@」，移到螢幕邊緣就不會打開 Dock 或控制中心。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用鼠标或触控板时，打开“%1$@”>“%2$@”，移到屏幕边缘就不会弹出程序坞或控制中心。"
          }
