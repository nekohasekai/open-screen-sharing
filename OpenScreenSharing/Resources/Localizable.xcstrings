        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing ಆ್ಯಪ್‌ಗೆ ಹಿನ್ನೆಲೆಯಲ್ಲಿ ಸೆಟ್ಟಿಂಗ್ಸ್ ಆ್ಯಪ್‌ಗಾಗಿ ಕಾಯುವುದನ್ನು ಮುಂದುವರಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing이 백그라운드에서 설정 앱을 계속 기다릴 수 없었습니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Screen Sharing” negalėjo toliau fone laukti programos „Nustatymai”."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing-ന് പശ്ചാത്തലത്തിൽ ‘ക്രമീകരണ’ത്തിനായി തുടർന്നും കാത്തിരിക്കാനായില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing बॅकग्राउंडमध्ये सेटिंग्जची वाट पाहत राहू शकले नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing tidak dapat terus menunggu Seting di latar belakang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing kunne ikke fortsette å vente på Innstillinger i bakgrunnen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing kon niet op de achtergrond blijven wachten op Instellingen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing ବ୍ୟାକ୍‌ଗ୍ରାଉଣ୍ଡ୍‌ରେ ସେଟିଂସ୍ ପାଇଁ ଅପେକ୍ଷା କରିବା ଜାରି ରଖିପାରିଲା ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing ਵੱਲੋਂ ਬੈਕਗਰਾਊਂਡ ਵਿੱਚ ਸੈਟਿੰਗਾਂ ਦੀ ਉਡੀਕ ਜਾਰੀ ਨਹੀਂ ਰੱਖੀ ਜਾ ਸਕੀ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja Screen Sharing nie mogła dalej czekać w tle na Ustawienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
