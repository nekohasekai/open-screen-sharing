        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Screen Sharing appnak a háttérben is futnia kell ahhoz, hogy továbbra is megoszthassa az eszköz képernyőjét."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing perlu tetap berjalan di latar belakang agar dapat terus membagikan layar perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing deve restare in esecuzione in background per continuare a condividere lo schermo di questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスの画面を共有し続けるには、Screen Sharingをバックグラウンドで実行し続ける必要があります。"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осы құрылғының экранын бөлісуді жалғастыру үшін Screen Sharing фондық режимде жұмыс істеп тұруы керек."
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಸಾಧನದ ಸ್ಕ್ರೀನ್ ಹಂಚಿಕೊಳ್ಳುವುದನ್ನು ಮುಂದುವರಿಸಲು, Screen Sharing ಆ್ಯಪ್ ಹಿನ್ನೆಲೆಯಲ್ಲಿ ಚಾಲನೆಯಲ್ಲಿರಬೇಕು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 화면을 계속 공유하려면 Screen Sharing이 백그라운드에서 계속 실행되어야 합니다."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kad šio įrenginio ekranas būtų toliau bendrinamas, „Screen Sharing” turi veikti fone."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ ഡിവൈസിന്റെ സ്ക്രീൻ തുടർന്നും പങ്കിടാൻ Screen Sharing പശ്ചാത്തലത്തിൽ പ്രവർത്തിച്ചുകൊണ്ടിരിക്കണം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या डिव्हाइसची स्क्रीन शेअर करत राहण्यासाठी Screen Sharing बॅकग्राउंडमध्ये चालू राहणे आवश्यक आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing perlu kekal berjalan di latar belakang untuk terus berkongsi skrin peranti ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing må kjøre i bakgrunnen for å fortsette å dele skjermen på denne enheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing moet op de achtergrond actief blijven om het scherm van dit apparaat te blijven delen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହି ଡିଭାଇସ୍‌ର ସ୍କ୍ରିନ୍ ଶେୟାର୍ କରିବା ଜାରି ରଖିବା ପାଇଁ Screen Sharing କୁ ବ୍ୟାକ୍‌ଗ୍ରାଉଣ୍ଡ୍‌ରେ ଚାଲୁ ରହିବା ଆବଶ୍ୟକ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਡਿਵਾਈਸ ਦੀ ਸਕਰੀਨ ਸਾਂਝੀ ਕਰਦੇ ਰਹਿਣ ਲਈ Screen Sharing ਦਾ ਬੈਕਗਰਾਊਂਡ ਵਿੱਚ ਚੱਲਦੇ ਰਹਿਣਾ ਲੋੜੀਂਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja Screen Sharing musi działać w tle, aby nadal udostępniać ekran tego urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Screen Sharing precisa continuar em execução em segundo plano para manter o compartilhamento da tela deste dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Screen Sharing tem de continuar em execução em segundo plano para manter a partilha do ecrã deste dispositivo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplicația Screen Sharing trebuie să ruleze în fundal pentru a continua partajarea ecranului acestui dispozitiv."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложению Screen Sharing необходимо работать в фоновом режиме, чтобы продолжать общий доступ к экрану этого устройства."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apka Screen Sharing musí zostať spustená na pozadí, aby mohla ďalej zdieľať obrazovku tohto zariadenia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacija Screen Sharing mora delovati v ozadju, da lahko še naprej deli zaslon te naprave."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing måste fortsätta köras i bakgrunden för att kunna dela skärmen på den här enheten."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தச் சாதனத்தின் திரையைத் தொடர்ந்து பகிர Screen Sharing பின்னணியில் இயங்கிக்கொண்டிருக்க வேண்டும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ డివైజ్ స్క్రీన్‌ను షేర్ చేస్తూ ఉండటానికి Screen Sharing బ్యాక్‌గ్రౌండ్‌లో రన్ అవుతూ ఉండాలి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing ต้องทำงานอยู่ในเบื้องหลังเพื่อแชร์หน้าจอของอุปกรณ์นี้ต่อไป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aygıtın ekranını paylaşmayı sürdürmek için Screen Sharing’in arka planda çalışmaya devam etmesi gerekir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програма Screen Sharing має працювати у фоновому режимі, щоб і далі поширювати екран цього пристрою."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس ڈیوائس کی اسکرین شیئر کرتے رہنے کے لیے Screen Sharing کا پس منظر میں چلتے رہنا ضروری ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing cần tiếp tục chạy trong nền để duy trì chia sẻ màn hình của thiết bị này."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Sharing 需要在背景保持執行，才能持續共享此裝置的螢幕。"
          }
        },
        "zh-Hans" : {
