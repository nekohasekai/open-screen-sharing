        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magic Keyboard இணைக்கப்பட்டிருக்கும்போது, இந்த iPad இன் %1$@ டிக்டேஷன் மற்றும் %2$@ ஈமோஜி விசைப்பலகையையும் பயன்படுத்தலாம்."
          }
