        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்தக் கம்ப்யூட்டர் தனது அடையாளத்தை உறுதிப்படுத்த முடியாத பழைய உள்நுழைவு முறையை மட்டுமே வழங்குகிறது. வேறொரு சாதனம் இந்தக் கம்ப்யூட்டர் போல நடித்தால், அது உங்கள் கடவுச்சொல்லைப் பார்க்கக்கூடும்."
          }
