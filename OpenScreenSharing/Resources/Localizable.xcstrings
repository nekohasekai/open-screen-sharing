            "state" : "translated",
            "value" : "输入用户名和密码以登录“%@”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入使用者名稱和密碼以登入「%@」。"
          }
        }
