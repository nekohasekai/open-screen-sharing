            "value" : "“%@” ಕಂಪ್ಯೂಟರ್‌ಗೆ ಸೈನ್ ಇನ್ ಮಾಡಲು ಬಳಕೆದಾರರ ಹೆಸರು ಮತ್ತು ಪಾಸ್‌ವರ್ಡ್ ನಮೂದಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’에 로그인하려면 사용자 이름과 암호를 입력하십시오."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Įveskite naudotojo vardą ir slaptažodį, kad prisijungtumėte prie „%@”."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ എന്നതിലേക്ക് സൈൻ ഇൻ ചെയ്യാൻ ഉപയോക്തൃനാമവും പാസ്‌വേഡും നൽകൂ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’ मध्ये साइन इन करण्यासाठी वापरकर्ता नाव आणि पासवर्ड एंटर करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masukkan nama pengguna dan kata laluan untuk daftar masuk ke “%@”."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppgi brukernavnet og passordet for å logge på «%@»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer de gebruikersnaam en het wachtwoord in om in te loggen bij '%@'."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ରେ ସାଇନ୍ ଇନ୍ କରିବା ପାଇଁ ୟୁଜର୍‌ନେମ୍ ଓ ପାସ୍‌ୱର୍ଡ୍ ଏଣ୍ଟର୍ କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ਵਿੱਚ ਸਾਈਨ ਇਨ ਕਰਨ ਲਈ ਵਰਤੋਂਕਾਰ ਨਾਮ ਅਤੇ ਪਾਸਵਰਡ ਦਾਖ਼ਲ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wprowadź nazwę użytkownika i hasło, aby zalogować się do „%@”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite o nome de usuário e a senha para iniciar sessão em “%@”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduza o nome de utilizador e a palavra‑passe para iniciar sessão em “%@”."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduceți numele de utilizator și parola pentru a vă autentifica pe „%@”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите имя пользователя и пароль для входа на «%@»."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadajte užívateľské meno a heslo na prihlásenie do „%@“."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vnesite uporabniško ime in geslo za vpis v računalnik »%@«."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ange användarnamnet och lösenordet för att logga in på “%@”."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”-இல் உள்நுழைய பயனர்பெயரையும் கடவுச்சொல்லையும் உள்ளிடவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”కు సైన్ ఇన్ చేయడానికి యూజర్ పేరును, పాస్‌వర్డ్‌ను నమోదు చేయండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ป้อนชื่อผู้ใช้และรหัสผ่านเพื่อลงชื่อเข้า “%@”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” için kullanıcı adını ve parolayı girin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введіть імʼя користувача і пароль, щоб увійти на «%@»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“⁨%@⁩” میں سائن اِن کرنے کے لیے صارف نام اور پاس ورڈ درج کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhập tên người dùng và mật khẩu để đăng nhập vào “%@”."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入用户名稱和密碼以登入「%@」。"
          }
        },
        "zh-Hans" : {
