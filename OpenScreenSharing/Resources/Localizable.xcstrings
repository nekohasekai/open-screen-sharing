        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac ਨੂੰ ਮੁੜ-ਸਥਾਪਤ ਕਰਨ ਤੋਂ ਬਾਅਦ ਇਹ ਹੋਣਾ ਆਮ ਗੱਲ ਹੈ। ਜੇਕਰ ਅਜਿਹਾ ਨਹੀਂ ਹੋਇਆ, ਤਾਂ ਹੋ ਸਕਦਾ ਹੈ ਕਿ ਕੋਈ ਹੋਰ ਡਿਵਾਈਸ ਇਹ Mac ਹੋਣ ਦਾ ਦਿਖਾਵਾ ਕਰ ਰਿਹਾ ਹੋਵੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
